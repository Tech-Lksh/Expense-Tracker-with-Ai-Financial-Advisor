# ============== SERVER ==============
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_VERSION=v1

# ============== DATABASE ==============
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/expense_tracker

# ============== REDIS (caching + BullMQ job queues) ==============
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ============== JWT AUTH ==============
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost

# ============== GOOGLE MAPS PLATFORM ==============
# Enable these APIs in Google Cloud Console: Geocoding API, Places API, Maps JavaScript API
GOOGLE_MAPS_API_KEY=replace_with_your_google_maps_api_key

# ============== AI ADVISOR (optional) ==============
# Add a Gemini API key to enable open-ended AI advisor responses.
GEMINI_API_KEY=

# ============== RATE LIMITING ==============
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# ============== LOGGING ==============
LOG_LEVEL=info
